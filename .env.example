# VYRA Docker Compose defaults.
# Copy this file to .env for local runs and replace the secrets before sharing
# any public or production deployment.

JWT_SECRET=replace-with-a-random-hex-string
WORKER_SECRET=replace-with-a-random-hex-string

# Public dashboard/API URLs used by the browser app and relay.
DASHBOARD_URL=http://localhost:5173
VITE_RELAY_API_URL=http://localhost:8020

# Relay/CV defaults
FRAME_INTERVAL_SECONDS=0.2
CV_FRAME_BATCH_SIZE=10
AUTO_REQUEST_REALTIME_STREAM=true
SNAPSHOT_RETENTION_DAYS=7
SIGNUP_ENABLED=false

# Ask-AI worker defaults
LLM_WORKER_URL=http://llm-worker:5003
LLM_MODEL_ID=google/gemma-3-1b-it
MAX_ANSWER_TOKENS=220
LLM_TEMPERATURE=0.2
