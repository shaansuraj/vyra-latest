# Relay Configuration (local)
#
# APP_DIR is where the relay stores:
# - storage/frames
# - database/relay.db
#
# This path is relative to the relay folder. With this value, your data will live in:
#   application/.hexvision_data
APP_DIR=../.hexvision_data

# CV Processing fallback — camera settings now drive extraction directly.
FRAME_INTERVAL_SECONDS=0.066667
CV_FRAME_BATCH_SIZE=1
LEGACY_MODE=false
IDENTITY_CROSS_CAMERA_MIN_GAP_SECONDS=0
PERSON_REID_MIN_QUALITY_SCORE=0.20

# Ports
RELAY_PORT=9020
API_PORT=8020

# Dashboard URL
DASHBOARD_URL=http://localhost:5173

# Realtime Streams
AUTO_REQUEST_REALTIME_STREAM=true

# WebRTC ICE servers for browser video tiles.
# Default behavior is Google STUN only, which is usually not enough when the app
# is exposed through Cloudflare Tunnel and viewers are outside your LAN.
# Add a TURN server here for remote viewers.
# Example:
# WEBRTC_ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.yourdomain.com:3478?transport=udp"],"username":"demo","credential":"secret"}]

# Security
JWT_SECRET=change-me

# Dev Mode (leave empty for normal login)
DEV_IMPERSONATE=

# Public signup toggle (default false unless explicitly true)
SIGNUP_ENABLED=false

# Process manager (optional; disabled when VYRA_ROOT is empty)
VYRA_ROOT=
FRONTEND_DIST_DIR=
ENGINE_PORT=5000
WORKER_SECRET=change-me

# Process lifecycle policy (recommended local production defaults)
PROCESS_SELF_HEAL_ENABLED=true
PROCESS_AUTO_START_DEPENDENCIES=true
PROCESS_AUTO_START_ENGINE=true
PROCESS_AUTO_SCALE_ENABLED=true
PROCESS_AUTO_SCALE_MAX=8
PROCESS_AUTO_SCALE_INTERVAL_SECONDS=3

# Face enrollment quality / readiness
# Reject low-quality uploads and require N accepted profiles before ready.
FACE_ENROLLMENT_ENFORCE_QUALITY=true
FACE_ENROLLMENT_MIN_PROFILES=3
