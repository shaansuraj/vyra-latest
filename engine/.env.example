# unblink-engine environment (local)
#
# WORKER_SECRET is shared between the engine and all python workers.
# Generate a strong random value for production.
WORKER_SECRET=change-me

# Optional HuggingFace token (only needed if your workers pull gated models)
HF_TOKEN=

# Optional: reduce generation length for VLM worker
MAX_NEW_TOKENS=256
LEGACY_MODE=false
PERSON_REID_BACKEND=fastreid
PERSON_REID_MODEL=osnet_ain_x1_0
PERSON_REID_TRACK_FUSION_WINDOW=4

# Detection worker VLM summaries
OBJECT_DET_ENABLE_VLM=1
PPE_ENABLE_VLM=1

# Face recognition v2 (default pipeline)
# Set to 0 only if you need legacy fallback for debugging.
FACE_RECOGNITION_V2_ENABLED=1
FACE_PRIMARY_MODEL=buffalo_l
FACE_SECONDARY_MODEL=buffalo_sc
FACE_SECONDARY_ENABLED=1
FACE_ENROLLMENT_MIN_PROFILES=3

# Matching thresholds
FACE_MATCH_STRONG_THRESHOLD=0.52
FACE_MATCH_WEAK_THRESHOLD=0.42
FACE_MATCH_MIN_MARGIN=0.035
FACE_MATCH_TOP_K=3

# Track-level retry/evidence controls (used when FACE_RECOGNITION_V2_ENABLED=1)
FACE_TRACK_RETRY_INTERVAL_S=0.6
FACE_TRACK_MAX_RETRIES=8
FACE_TRACK_BOOTSTRAP_ATTEMPTS=3
FACE_TRACK_BOOTSTRAP_INTERVAL_S=0.25
FACE_TRACK_EVIDENCE_WINDOW=5
FACE_TRACK_WEAK_PROMOTE_HITS=3

# matcher/track diagnostics logs
FACE_DIAGNOSTICS=0

# PPE hardening: require NO-* violations to be linked to a tracked person.
PPE_REQUIRE_PERSON_ASSOCIATION=1

# PPE worker face-ID is optional. Keep disabled to reduce GPU memory;
# person/object detection already handles face recognition and naming.
PPE_ENABLE_FACE_RECOGNITION=0
